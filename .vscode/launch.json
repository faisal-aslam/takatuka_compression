{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug iterative_rle",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/iterative_rle_debug",
            "args": ["./tests/test.bin", "output.bin"], 
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,          
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "make"
        }
    ]
}